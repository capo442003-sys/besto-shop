# ═══════════════════════════════════════════════════════════════
# BMB — Cloud Railway + Vercel (bmbgestion.uk)
# ═══════════════════════════════════════════════════════════════
# 1. Copiez :  copy deploy\.cloud.env.example deploy\.cloud.env
# 2. Générez :  powershell -File deploy\apply-cloud-config.ps1
# 3. Suivez :   deploy\generated\CLOUD-DEPLOI.txt
# ═══════════════════════════════════════════════════════════════

# ─── Domaines ───
DOMAIN=bmbgestion.uk
WWW_DOMAIN=www.bmbgestion.uk
API_DOMAIN=api.bmbgestion.uk

# ─── Railway (backend) ───
NODE_ENV=production
SERVE_CLIENT=0
PORT=3001
JWT_EXPIRES_IN=12h
# Laisser vide = clé aléatoire générée par apply-cloud-config.ps1
JWT_SECRET=
ALLOW_VERCEL_CORS=1

# ─── Vercel (frontend) ───
# Projet Vercel (optionnel, pour le script deploy)
VERCEL_PROJECT_NAME=bmb-gestion

# ─── Google Drive OAuth (hébergeur, une fois) ───
# Projet GCP : bmb-gestion-oauth (Drive API activée)
# Console : https://console.cloud.google.com/auth/clients?project=bmb-gestion-oauth
# Redirect URI : https://bmb-api-production.up.railway.app/api/backups/google/callback
GCP_PROJECT_ID=bmb-gestion-oauth
RAILWAY_SERVICE=bmb-api
RAILWAY_API_URL=https://bmb-api-production.up.railway.app
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://bmb-api-production.up.railway.app/api/backups/google/callback
