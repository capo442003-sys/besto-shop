PORT=3001
NODE_ENV=development

# PostgreSQL local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bmb_gestion

JWT_SECRET=changez_ce_secret_en_production_bmb_2026
JWT_EXPIRES_IN=12h

# Frontend (CORS) — en mode web local : http://localhost:3001
# Plusieurs origines possibles : http://localhost:3001,https://bmbgestion.com
# Cloud Vercel : https://votre-projet.vercel.app
CLIENT_URL=http://localhost:5173

# Cloud Railway + Vercel : ne pas servir le frontend depuis l'API
# SERVE_CLIENT=0

# Autoriser les previews Vercel (*.vercel.app) — utile avec Vercel + Railway
# ALLOW_VERCEL_CORS=1

# HTTPS (optionnel, réseau local / PWA)
# SSL_KEY_PATH=backend/certs/server.key
# SSL_CERT_PATH=backend/certs/server.crt
# HTTPS=1

# Google Drive — OAuth app (hébergeur BMB, une fois)
# Console Google Cloud → OAuth 2.0 → redirect URI = BACKEND_PUBLIC_URL/api/backups/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
BACKEND_PUBLIC_URL=http://localhost:3001

# Sauvegarde automatique quotidienne (compte Google du client connecté dans l'app)
# BACKUP_CRON=0 3 * * *
# BACKUP_TZ=Africa/Conakry
# BACKUP_CRON_ENABLED=1
