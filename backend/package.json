{
  "name": "bmb-backend",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/free-port.js 3001 && node --watch-path=./src --watch src/index.js",
    "start": "node src/index.js",
    "start:cloud": "node src/db/migrate.js && node src/db/seed.js && node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:roles": "node src/db/migrate-roles.js",
    "db:seed": "node src/db/seed.js",
    "db:clear": "node src/db/clear-data.js",
    "backup:gdrive": "node scripts/backup-google-drive.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "socket.io": "^4.7.5",
    "unzipper": "^0.12.3"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
