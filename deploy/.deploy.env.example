# ═══════════════════════════════════════════════════════════════
# BMB Gestion — Configuration déploiement (Ubuntu + Cloudflare)
# ═══════════════════════════════════════════════════════════════
# 1. Copiez ce fichier :  cp deploy/.deploy.env.example deploy/.deploy.env
# 2. Remplissez les valeurs A_REMPLIR
# 3. Générez les configs :
#      Windows :  powershell -File deploy/apply-config.ps1
#      Ubuntu  :  bash deploy/generate-config.sh
# ═══════════════════════════════════════════════════════════════

# ─── Domaine public ───
DOMAIN=bmbgestion.com
WWW_DOMAIN=www.bmbgestion.com

# ─── Application Node ───
WEB_PORT=3001
SERVE_CLIENT=1
NODE_ENV=production

# ─── PostgreSQL (sur le même serveur Ubuntu) ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_NAME=bmbgestion
DB_USER=bmb
DB_PASSWORD=A_REMPLIR

# ─── Sécurité API ───
# Laisser JWT_SECRET vide = clé aléatoire générée automatiquement
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ─── Cloudflare Tunnel (cloudflared) ───
# Après : cloudflared tunnel create bmbgestion
TUNNEL_NAME=bmbgestion
TUNNEL_UUID=A_REMPLIR
# Chemin du fichier credentials (souvent /root/.cloudflared/<UUID>.json)
CLOUDFLARED_CREDENTIALS=/root/.cloudflared/A_REMPLIR.json
# Token tunnel (cloudflared service install) — optionnel si UUID renseigné
CLOUDFLARED_TOKEN=

# ─── Serveur ───
APP_PATH=/opt/bmbgestion

# ─── Optionnel — sauvegarde Google Drive ───
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
